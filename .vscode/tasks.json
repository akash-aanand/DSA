{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current C++ File",
            "type": "shell",
            "command": "g++ \"${file}\" -std=c++17 -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\" < \"${workspaceFolder}/input.txt\" > \"${workspaceFolder}/output.txt\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}